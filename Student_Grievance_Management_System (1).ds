 application "Student Grievance Management System"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "America/Los_Angeles"
 	time format = "24-hr"

 	forms
	{
		form grievance
		{
			displayname = "Grievance"
			success message = "Grievance Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			raised_on
			(
    			type = date
				displayname = "Raised On"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			category
			(
				type = picklist
				displayname = "Category"
				values = {"Hostel","Infrastructure","Academic","Transport","Fees","Other"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			description
			(
    			type = textarea
				displayname = "Description"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			priority
			(
				type = picklist
				displayname = "Priority"
				values = {"High","Low","Medium"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			status
			(
				type = picklist
				displayname = "Status"
				values = {"Under Review","Closed","Resolved","Open"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			resolved_on
			(
    			type = date
				displayname = "Resolved On"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			days_to_resolve
			(
				type = number
				displayname = "Days To Resolve"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			anonymous
			(
    			type = checkbox
				displayname = "Anonymous"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			raised_by_name
			(
    			type = name
				displayname = "Raised By Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
	     			 visibility = false
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			raised_by_email
			(
    			type = email
				displayname = "Raised By Email"
	 			row = 1
	 			column = 1   
				width = medium
			)
			assigned_officer
			(
    			type = name
				displayname = "Assigned Officer"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
	     			 visibility = false
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Grievance Raised","Grievance Assigned","Grievance Rejected","Grievance Under Review","Grievance Reassigned","Grievance Escalated","Grievance Resolved","Grievance Pending Information","Grievance Closed","Grievance Reopened"}
			}
		}
	}
	reports
	{
		list grievance_Report
		{
			displayName = "All Grievances"
			show all rows from grievance    
			(
				raised_on as "Raised On"
				category as "Category"
				description as "Description"
				priority as "Priority"
				status as "Status"
				resolved_on as "Resolved On"
				days_to_resolve as "Days To Resolve"
				anonymous as "Anonymous"
				raised_by_name  as "Raised By Name"
				raised_by_email as "Raised By Email"
				assigned_officer  as "Assigned Officer"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (priority == "High")
				fields = [priority]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (priority == "Low")
				fields = [priority]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (priority == "Medium")
				fields = [priority]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		}
		kanban grievance_by_category
		{
			displayName = "Categories"
			show all rows from grievance    
			(
				raised_on as "Raised On"
				category as "Category"
				description as "Description"
				priority as "Priority"
				status as "Status"
				resolved_on as "Resolved On"
				days_to_resolve as "Days To Resolve"
				anonymous as "Anonymous"
				raised_by_name  as "Raised By Name"
				raised_by_email as "Raised By Email"
				assigned_officer  as "Assigned Officer"
			)
			options
			(
	 			display field = category
	 		)
		}
	}
