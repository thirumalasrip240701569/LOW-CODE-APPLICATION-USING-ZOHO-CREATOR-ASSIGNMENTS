		workflow
		{
		form
		{
			auto_calculate_resolution_days as "Auto-calculate Resolution Days"
			{
				type =  form
				form = grievance

				record event = on edit

				on user input of status
				{
					actions 
					{
						custom deluge script
						(
											// Fetch the current grievance record
										if(input.status == "Resolved")
										{
											// Get the raised_on date from the current record
											raisedOnDate = input.raised_on;
											// Get the resolved_on date from the current record
											resolvedOnDate = input.resolved_on;
											// Calculate days to resolve if both dates are valid
											if(raisedOnDate.isValidObject() && resolvedOnDate.isValidObject())
											{
												// Calculate the number of days between raised_on and resolved_on
												daysToResolve = raisedOnDate.daysBetween(resolvedOnDate);
												// Update the days_to_resolve field with the calculated value
												input.days_to_resolve = daysToResolve;
											}
										}
						)
					}
				}

			}
			hide_anonymous_name_field as "Hide Anonymous Name Field"
			{
				type =  form
				form = grievance

				record event = on add

				on user input of anonymous
				{
					actions 
					{
						custom deluge script
						(
											// Hide raised_by_name field if anonymous complaint is selected
										if(input.anonymous == true)
										{
											hide raised_by_name;
										}
										else
										{
											show raised_by_name;
										}
						)
					}
				}

			}
		}




